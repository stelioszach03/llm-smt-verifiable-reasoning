{
  "name": "CEGVR Dev Container",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": ".."
  },
  "settings": {
    "python.pythonPath": "/usr/local/bin/python",
    "python.formatting.provider": "black"
  },
  "postCreateCommand": "scripts/repro.sh",
  "mounts": [
    "source=cegvr_workspace,target=/workspace,type=volume"
  ],
  "remoteUser": "root"
}
