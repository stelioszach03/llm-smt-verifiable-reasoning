# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/

# Environments
.env
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Coverage
.coverage
htmlcov/

# IDEs and editors
.idea/
.vscode/
*.swp
*.swo
# Raw per-problem run logs stay out of git (~18 MB for one full 5-arm sweep).
/runs/

# Aggregated result tables are small and are the evidence for every number in
# the README, so CSVs under tables/ are deliberately tracked.
/tables/**
!/tables/
!/tables/**/
!/tables/**/*.csv

reports/case_studies.md
examples/paper_assets/figures/
examples/paper_assets/tables/
examples/paper_assets/latex/*.pdf
!examples/paper_assets/latex/legacy_2025-10-11_llama3-8b.pdf

# Ensure we never ignore the source package tables module
!src/cegvr/tables/
!src/cegvr/tables/**

# Large artifacts / external assets
datasets/
models/
*.gguf
*.pt
*.ckpt
*.bin
*.tar
*.tar.gz
*.zip
*.zst

# Hypothesis example database (local test cache)
.hypothesis/
